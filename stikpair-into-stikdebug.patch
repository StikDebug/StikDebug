+//
+//  PairingView.swift
+//  StikDebug
+//
+//  On-device pairing file creation, ported from StikPair (StephenDev0/StikPair).
+//
+
+import SwiftUI
+
+struct PairingView: View {
+    @ObservedObject private var controller = PairingController.shared
+    @State private var appleTVPin = ""
+    @State private var installError: String?
+
+    var body: some View {
+        Form {
+            content
+        }
+        .navigationTitle("Create Pairing File")
+        .navigationBarTitleDisplayMode(.inline)
+        .animation(.default, value: controller.phase)
+        .onDisappear {
+            controller.cancelIfRunning()
+            controller.reset()
+        }
+    }
+
+    @ViewBuilder
+    private var content: some View {
+        switch controller.phase {
+        case .idle:
+            idleSections
+
+        case .waiting:
+            Section {
+                HStack(spacing: 12) {
+                    ProgressView()
+                    Text("Waiting for a device to connect…")
+                        .foregroundStyle(.secondary)
+                }
+            }
+            Section {
+                guideStep(1, "Open the **Settings** app")
+                guideStep(2, "Go to **Privacy & Security**")
+                guideStep(3, "Tap **Developer Mode**")
+                guideStep(4, "Scroll down and tap **Pair with \(PairingController.hostName)**")
+            } header: { Text("On the device being paired") } footer: {
+                Text("If **Pair with \(PairingController.hostName)** doesn't show up, cancel and try again.")
+            }
+            Section {
+                Button("Cancel", role: .cancel) { controller.cancelHostPairing() }
+            }
+
+        case .showPin(let pin):
+            Section {
+                VStack(spacing: 14) {
+                    Text("Enter this code on your device")
+                        .font(.headline)
+                    Text(pin)
+                        .font(.system(size: 44, weight: .bold, design: .rounded))
+                        .monospacedDigit()
+                        .tracking(8)
+                        .textSelection(.enabled)
+                    ProgressView()
+                }
+                .frame(maxWidth: .infinity)
+                .padding(.vertical, 8)
+            }
+            Section {
+                Button("Cancel", role: .cancel) { controller.cancelHostPairing() }
+            }
+
+        case .browsingAppleTV:
+            Section {
+                if controller.appleTVs.isEmpty {
+                    HStack(spacing: 12) {
+                        ProgressView()
+                        Text("Looking for Apple TVs…")
+                            .foregroundStyle(.secondary)
+                    }
+                } else {
+                    ForEach(controller.appleTVs) { device in
+                        Button {
+                            appleTVPin = ""
+                            controller.pairAppleTV(device)
+                        } label: {
+                            Label(device.name, systemImage: "appletv")
+                        }
+                    }
+                }
+            } header: {
+                Text("Choose an Apple TV")
+            } footer: {
+                Text("On Apple TV, open **Settings › Remotes and Devices › Remote App and Devices**.")
+            }
+            Section {
+                Button("Cancel", role: .cancel) { controller.cancelAppleTVPairing() }
+            }
+
+        case .enteringAppleTVPin(let device):
+            Section {
+                TextField("000000", text: $appleTVPin)
+                    .keyboardType(.numberPad)
+                    .textContentType(.oneTimeCode)
+                    .multilineTextAlignment(.center)
+                    .font(.system(size: 32, weight: .bold, design: .rounded))
+                    .monospacedDigit()
+                    .onChange(of: appleTVPin) { _, value in
+                        appleTVPin = String(value.filter(\.isNumber).prefix(6))
+                    }
+                Button("Pair") {
+                    controller.submitAppleTVPin(appleTVPin)
+                }
+                .disabled(appleTVPin.count != 6)
+            } header: {
+                Text("Pair with \(device.name)")
+            } footer: {
+                Text("Enter the six-digit code shown on your Apple TV.")
+            }
+            Section {
+                Button("Cancel", role: .cancel) { controller.cancelAppleTVPairing() }
+            }
+
+        case .pairingAppleTV(let name):
+            Section {
+                HStack(spacing: 12) {
+                    ProgressView()
+                    Text("Pairing with \(name)…")
+                        .foregroundStyle(.secondary)
+                }
+            }
+            Section {
+                Button("Cancel", role: .cancel) { controller.cancelAppleTVPairing() }
+            }
+
+        case .success(let device):
+            successSections(device)
+
+        case .failed(let message):
+            Section {
+                Label("Pairing failed", systemImage: "xmark.octagon.fill")
+                    .foregroundStyle(.red)
+                Text(message)
+                    .font(.footnote)
+                    .foregroundStyle(.secondary)
+                    .textSelection(.enabled)
+            }
+            Section {
+                Button("Try Again") { controller.reset() }
+            }
+        }
+    }
+
+    @ViewBuilder
+    private var idleSections: some View {
+        Section {
+            Button {
+                controller.start()
+            } label: {
+                Label("Pair iPhone or iPad", systemImage: "iphone")
+            }
+            Button {
+                controller.browseForAppleTVs()
+            } label: {
+                Label("Pair Apple TV", systemImage: "appletv")
+            }
+        } footer: {
+            Text("Creates a pairing file directly on this device, with no computer. The device being paired must run iOS 27 or later (or tvOS for Apple TV).")
+        }
+    }
+
+    @ViewBuilder
+    private func successSections(_ device: PairingController.PairedDevice) -> some View {
+        Section {
+            Label("Paired", systemImage: "checkmark.seal.fill")
+                .foregroundStyle(.green)
+            if !device.name.isEmpty {
+                Text(device.model.isEmpty ? device.name : "\(device.name) · \(device.model)")
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+            }
+        }
+
+        Section {
+            if device.canInstall {
+                if controller.didInstallPairingFile {
+                    Label("Now used by StikDebug", systemImage: "checkmark.circle.fill")
+                        .foregroundStyle(.green)
+                } else {
+                    Button {
+                        do {
+                            try controller.installPairingFile()
+                            installError = nil
+                        } catch {
+                            installError = error.localizedDescription
+                        }
+                    } label: {
+                        Label("Use for StikDebug", systemImage: "arrow.down.doc")
+                    }
+                }
+            }
+            ShareLink(item: device.fileURL) {
+                Label("Export Pairing File", systemImage: "square.and.arrow.up")
+            }
+            if let installError {
+                Text(installError)
+                    .font(.caption)
+                    .foregroundStyle(.red)
+            }
+        } footer: {
+            if device.canInstall {
+                Text("“Use for StikDebug” replaces the pairing file StikDebug currently uses. You can also export the file for other tools.")
+            }
+        }
+
+        Section {
+            Button("Done") { controller.reset() }
+        }
+    }
+
+    private func guideStep(_ number: Int, _ text: LocalizedStringKey) -> some View {
+        HStack(alignment: .firstTextBaseline, spacing: 10) {
+            Text("\(number)")
+                .font(.caption.bold())
+                .foregroundStyle(.white)
+                .frame(width: 20, height: 20)
+                .background(.tint, in: Circle())
+            Text(text)
+                .font(.subheadline)
+                .fixedSize(horizontal: false, vertical: true)
+        }
+    }
+}
