        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 iloader 生成并放置新的配对文件。"
          }
        }
      }
    },
    "Check Target Device IP in Settings. Enter an IPv4 address such as 10.7.0.1.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Target Device IP in Settings. Enter an IPv4 address such as 10.7.0.1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中检查目标设备 IP。请输入一个 IPv4 地址，例如 10.7.0.1。"
          }
        }
      }
    },
    "Unlock the target device and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the target device and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请解锁目标设备后重试。"
          }
        }
      }
    },
    "Enable Developer Mode in the target device’s Settings → Privacy & Security, then follow its restart instructions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Developer Mode in the target device’s Settings → Privacy & Security, then follow its restart instructions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在目标设备的“设置 → 隐私与安全”中启用开发者模式，然后按照重启时的说明确认。"
          }
        }
      }
    },
    "Check that Developer Mode is enabled. Try reconnecting; if the service is still unavailable, redownload the developer disk image in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that Developer Mode is enabled. Try reconnecting; if the service is still unavailable, redownload the developer disk image in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查开发者模式是否已启用。尝试重新连接；如果服务仍不可用，请在设置中重新下载开发者映像。"
          }
        }
      }
    },
    "Keep LocalDevVPN connected. Enable Airplane Mode by swiping down from the top-right corner of your screen and tapping the airplane icon, then return here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep LocalDevVPN connected. Enable Airplane Mode by swiping down from the top-right corner of your screen and tapping the airplane icon, then return here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 LocalDevVPN 连接。启用飞行模式（或仅禁用蜂窝数据），然后重试。"
          }
        }
      }
    },
    "Disable Airplane Mode by swiping down from the top-right corner of your screen and tapping the airplane icon, then return here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable Airplane Mode by swiping down from the top-right corner of your screen and tapping the airplane icon, then return here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 Wi-Fi 或蜂窝数据，然后连接 LocalDevVPN。"
          }
        }
      }
    },
    "Connect LocalDevVPN, then return to StikDebug and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect LocalDevVPN, then return to StikDebug and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 LocalDevVPN，然后返回 StikDebug 并重试。"
          }
        }
      }
    },
    "Connect the VPN, then return here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the VPN, then return here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接 LocalDevVPN，然后返回 StikDebug 并重试。"
          }
        }
      }
    },
    "The device’s pairing service isn’t reachable. Check Remote Pairing Port in Settings. If it still fails, restart the device and reconnect LocalDevVPN.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device’s pairing service isn’t reachable. Check Remote Pairing Port in Settings. If it still fails, restart the device and reconnect LocalDevVPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备的配对服务无法访问。请检查设置中的远程配对端口。如果仍然失败，请重启设备并重新连接 LocalDevVPN。"
          }
        }
      }
    },
    "Check Target Device IP and Remote Pairing Port in Settings, and make sure the target device is reachable on your network.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Target Device IP and Remote Pairing Port in Settings, and make sure the target device is reachable on your network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查设置中的目标设备 IP 和远程配对端口，并确保目标设备在您的网络上可访问。"
          }
        }
      }
    },
    "Unlock the target device and try again. If the error continues, restart the target device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the target device and try again. If the error continues, restart the target device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请解锁目标设备后重试。如果错误仍然存在，请重启目标设备。"
          }
        }
      }
    },
    "Connected over Airplane Mode. You can now disable Airplane Mode if you wish, StikDebug will remain connected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected over Airplane Mode. You can now disable Airplane Mode if you wish, StikDebug will remain connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在没有 Wi-Fi 或蜂窝数据的情况下连接。您现在可以启用蜂窝数据，隧道将保持连接。"
          }
        }
      }
    },
